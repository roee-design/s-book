rules_version = '2';

// Security rules for the S-Book index.
// Paste into: Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validRating(d) {
      return d.keys().hasOnly(['title', 'score', 'rawScore', 'veto', 'inputs', 'createdBy', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.score is number && d.veto is bool && d.inputs is map
        && d.createdBy is string && d.createdAt is string && d.updatedAt is string;
    }

    // One document per rating. Everyone reads; you write only your own; admins write all.
    match /books/{id} {
      allow read: if true;
      allow create: if signedIn() && validRating(request.resource.data)
        && (request.resource.data.createdBy == request.auth.uid || isAdmin());
      allow update: if signedIn() && validRating(request.resource.data)
        && ((resource.data.createdBy == request.auth.uid
             && request.resource.data.createdBy == request.auth.uid) || isAdmin());
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Public display names.
    match /readers/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin())
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 40;
    }

    // Private reader profile (answers + I). Only the person themself.
    match /profiles/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Each person's "agree" votes, public so trust can be computed.
    match /likes/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.liked is map
        && request.resource.data.liked.size() <= 5000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Admin list. Created by hand in the console; never writable from the site.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
